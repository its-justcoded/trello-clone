// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
 id        String @id @default(uuid())
 email     String @unique
 password  String
 memebership Membership[]
 issue_map  Issue_Mapping[]
 
}

model Org{
 id         String @id @default(uuid())
 name       String
 description String
 membership Membership[]
 board  Board[]
}
enum Role{
  admin
  member
}

model Membership {
 id          String @id @default(uuid())
 role        Role
 userId      String
 author User @relation(fields:[userId], references:[id])
 orgId       String
 authors Org  @relation(fields:[orgId], references:[id])

 @@unique([userId,orgId])
}

model Sections {
 id          String @id @default(uuid())
 title       String
 boardId     String
 board   Board @relation(fields: [boardId] , references: [id])
 issue       Issue[]
}

model Issue {
 id        String @id @default(uuid())
 title     String
 description String
 sectionId    String
 section  Sections @relation(fields: [sectionId], references: [id])
  boardId     String
 board   Board @relation(fields: [boardId] , references: [id])
 issue_map    Issue_Mapping[]
 comments  Comments[]
}

model Board {
 id        String @id @default(uuid())
 title     String
 orgId     String
 org Org @relation (fields:[orgId], references:[id])
 section   Sections[]
 issue   Issue[]
 
}

model Issue_Mapping{
 id        String @id @default(uuid())
 userId    String
 user  User @relation(fields: [userId], references: [id])
 issueId   String
 issue    Issue @relation(fields: [issueId], references: [id])
}

model Comments{
  id      String @id @default(uuid())
  comments  String
  issueId  String
  issue Issue @relation(fields: [issueId],references: [id])
}


 